# Copia este archivo a .env y rellénalo.

# El dominio del servidor. Sin dominio propio vale el de sslip.io con la IP pública de la máquina
# (p. ej. 203-0-113-7.sslip.io): apunta solo a esa IP y Let's Encrypt le da certificado.
DOMAIN=203-0-113-7.sslip.io

# Una contraseña larga y aleatoria (p. ej. `openssl rand -hex 24`). La misma va en Vercel como ROUTING_TOKEN.
ROUTING_TOKEN=cambia-esto
